# Secrets: API keys live in .env only (.env.example is committed)
.env

# Python environments
.venv/
venv/

# Python build and tool caches
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
build/

# Raw API cache (OpenF1, Wikipedia) and driver headshots: never committed
data/cache/
data/headshots/
data/team_logos/

# Full local databases (the small sample in sample/ is committed on purpose)
data/*.db
data/chroma/

# Evaluation reports, made by python -m f1rag.eval
data/eval/

# Working copy of the sample, made by the app because ChromaDB writes to its folder
data/sample/

# Local planning docs: not committed for now
docs/

# macOS
.DS_Store
