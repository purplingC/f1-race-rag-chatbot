# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Free-tier Flash-class model. Phase 0 choice: gemini-3.5-flash-lite (500 requests/day free)
GEMINI_MODEL=gemini-3.5-flash-lite
# Official headshots are optional, loaded at runtime, never committed. Default: initials.
SHOW_HEADSHOTS=false
