# Copy to .env and fill in, never commit .env
GEMINI_API_KEY=
# Free-tier Flash-class model, Phase 0 choice: gemini-3.5-flash-lite (500 requests/day free)
GEMINI_MODEL=gemini-3.5-flash-lite
# Show official driver photos from data/headshots (local only, never committed), default: initials
SHOW_HEADSHOTS=false
# Show official team logos from data/team_logos (local only, never committed), default: off
SHOW_TEAM_LOGOS=false
